  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "phoneNumber",
          "email",
          "isFavourite",
          "contactType",
          "userId",
          "photo",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "description": "Contact id",
            "example": "68406392892f281e98de464a"
          },
          "name": {
            "type": "string",
            "description": "Contact name",
            "example": "Kateryna Kovalchuk"
          },
          "phoneNumber": {
            "type": "string",
            "description": "Phone contact",
            "example": 3800000000010
          },
          "email": {
            "type": "string",
            "description": "Email contact",
            "example": "andriy7@example.com"
          },
          "isFavourite": {
            "type": "boolean",
            "description": "Favourite contacts",
            "example": false
          },
          "contactType": {
            "type": "string",
            "description": "Contact type",
            "enum": [
              "work",
              "home",
              "personal"
            ],
            "example": "personal"
          },
          "userId": {
            "type": "string",
            "description": "Contact userId",
            "example": "684164740a83d714dfe66a01"
          },
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "Url of contact photo",
            "example": "https://res.cloudinary.com/dnnpxetem/image/upload/v1749718911/veirmv446v7wttgmqxxv.jpg"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Contact created at",
            "example": "2025-03-27T19:43:21.686+00:00"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Contact updated at",
            "example": "2025-03-28T19:43:21.686+00:00"
          }
        }
      },
      "contacts": {
        "type": "object",
        "required": [
          "page",
          "perPage",
          "totalItems",
          "totalPages",
          "hasPreviousPage",
          "hasNextPage"
        ],
        "properties": {
          "data": {
            "type": "array",
            "description": "Array of contacts",
            "items": {
              "$ref": "#/components/schemas/contact"
            }
          },
          "page": {
            "type": "integer",
            "description": "Number of page",
            "example": 2
          },
          "perPage": {
            "type": "integer",
            "description": "Count of contacts on one page",
            "example": 10
          },
          "totalItems": {
            "type": "integer",
            "description": "Count of contacts with given parameters in DB",
            "example": 200
          },
          "totalPages": {
            "type": "integer",
            "description": "Count of page with contacts with given parameters",
            "example": 20
          },
          "hasPreviousPage": {
            "type": "boolean",
            "description": "Have this page the previous page?",
            "example": false
          },
          "hasNextPage": {
            "type": "boolean",
            "description": "Have this page the next page?",
            "example": true
          }
        }
      },
      "user": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "email",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "description": "User`s id",
            "example": "68406392892f281e98de464a"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "description": "User`s name",
            "example": "Kateryna Kovalchuk"
          },
          "email": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "description": "User email",
            "example": "andriy7@example.com"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "User created at",
            "example": "2025-03-27T19:43:21.686+00:00"
          },
          "updatedAt": {
            "type": "string",
